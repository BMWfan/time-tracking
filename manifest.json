{
  "manifest_version": 3,
  "name": "Time Tracking",
  "version": "1.2.6",
  "description": "Clock in and out in SAP SuccessFactors Time Tracking, fill in missed days and set the place of work - from the toolbar, a keyboard shortcut or a desktop shortcut.",
  "key": "",
  "permissions": [
    "scripting",
    "tabs",
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.successfactors.eu/*",
    "https://*.successfactors.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Time Tracking",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "punch-in": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Kommt buchen (jetzt)"
    },
    "punch-out": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Geht buchen (jetzt)"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "homepage_url": "https://github.com/BMWfan/time-tracking"
}
